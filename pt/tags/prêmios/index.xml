    <item>
      <title>Reconhecimento e Conquistas na Inovação em Bombas Químicas</title>
      <link>https://mis3085.github.io/docs-assoma/pt/news/awards/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>https://mis3085.github.io/docs-assoma/pt/news/awards/</guid>
      <description>&lt;h2 class=&#34;relative group&#34;&gt;Celebrando o Reconhecimento da Indústria e a Excelência do Produto 
    &lt;div id=&#34;celebrando-o-reconhecimento-da-indústria-e-a-excelência-do-produto&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
