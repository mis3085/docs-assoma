    &lt;/span&gt;        
    
&lt;/h2&gt;
&lt;div id=&#34;gallery-bd5769355e91eb6bb9402b2b2bba82d0&#34; class=&#34;gallery&#34;&gt;
  
  
    
&lt;figure class=&#34;grid-w50 pb-4 text-center&#34;&gt;&lt;img src=&#34;https://mis3085.github.io/docs-assoma/green-assoma_banner_10856976880055840921.jpg&#34; alt=&#34;green-assoma_banner&#34; class=&#34;mx-auto max-w-full h-auto&#34;/&gt;&lt;figcaption&gt;green-assoma_banner&lt;/figcaption&gt;&lt;/figure&gt;
&lt;/div&gt;

