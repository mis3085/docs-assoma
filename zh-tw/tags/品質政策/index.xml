    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e5%85%ac%e5%8f%b8%e6%94%bf%e7%ad%96%e7%b8%bd%e8%a6%bd&#34; aria-label=&#34;定位點&#34;&gt;#&lt;/a&gt;
