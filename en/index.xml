    <item>
      <title>Advanced Solutions for Corrosive Chemical Filtration</title>
      <link>https://smp.assoma.com/en/products/chemical-pump-filters/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>https://smp.assoma.com/en/products/chemical-pump-filters/</guid>
      <description>&lt;h2 class=&#34;relative group&#34;&gt;Reliable Filtration for Demanding Chemical Applications 
    &lt;div id=&#34;reliable-filtration-for-demanding-chemical-applications&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
