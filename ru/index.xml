      <description>&lt;h2 class=&#34;relative group&#34;&gt;Наш подход к устойчивым инновациям 
    &lt;div id=&#34;наш-подход-к-устойчивым-инновациям&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%d0%bd%d0%b0%d1%88-%d0%bf%d0%be%d0%b4%d1%85%d0%be%d0%b4-%d0%ba-%d1%83%d1%81%d1%82%d0%be%d0%b9%d1%87%d0%b8%d0%b2%d1%8b%d0%bc-%d0%b8%d0%bd%d0%bd%d0%be%d0%b2%d0%b0%d1%86%d0%b8%d1%8f%d0%bc&#34; aria-label=&#34;Якорь&#34;&gt;#&lt;/a&gt;
