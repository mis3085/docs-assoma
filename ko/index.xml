        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700&#34;
            style=&#34;text-decoration-line: none !important;&#34; href=&#34;#%eb%b6%80%ec%8b%9d%ec%84%b1-%eb%b0%8f-%ec%9c%84%ed%97%98-%ed%99%94%ed%95%99%eb%ac%bc%ec%a7%88%ec%9d%84-%ec%9c%84%ed%95%9c-%ec%84%a4%ea%b3%84%eb%90%9c-%ed%8e%8c%ed%95%91-%ec%86%94%eb%a3%a8%ec%85%98&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
    &lt;/span&gt;        
    
