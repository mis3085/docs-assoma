        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ec%8b%a0%eb%a2%b0%ed%95%a0-%ec%88%98-%ec%9e%88%eb%8a%94-%ed%8e%8c%ed%94%84-%ec%9a%b4%ec%a0%84-%ec%9d%b4%ed%95%b4%ed%95%98%ea%b8%b0&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
