        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ed%99%94%ed%95%99-%ed%8e%8c%ed%95%91-%ec%8b%9c%ec%8a%a4%ed%85%9c%ec%9d%98-%ec%a7%80%ec%86%8d-%ea%b0%80%eb%8a%a5%ed%95%9c-%ed%98%81%ec%8b%a0&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
