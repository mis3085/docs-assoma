        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%ec%82%b0%ec%97%85-%eb%aa%a8%ec%9e%84-%eb%b0%8f-%ec%9d%b4%eb%b2%a4%ed%8a%b8-%ed%95%98%ec%9d%b4%eb%9d%bc%ec%9d%b4%ed%8a%b8&#34; aria-label=&#34;앵커&#34;&gt;#&lt;/a&gt;
