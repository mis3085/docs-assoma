    <item>
      <title>Protezione dei Sistemi di Pompe con Monitoraggio e Protezione da Funzionamento a Secco</title>
      <link>https://mis3085.github.io/docs-assoma/it/products/pump-protector-monitor/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
