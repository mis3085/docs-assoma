    <item>
      <title>Impegno per la Responsabilità Sociale e il Benessere dei Dipendenti</title>
      <link>https://mis3085.github.io/docs-assoma/it/abouts/corporate-responsibility/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>https://mis3085.github.io/docs-assoma/it/abouts/corporate-responsibility/</guid>
      <description>&lt;h2 class=&#34;relative group&#34;&gt;Il nostro approccio alla responsabilità sociale e alla sostenibilità 
    &lt;div id=&#34;il-nostro-approccio-alla-responsabilità-sociale-e-alla-sostenibilità&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
