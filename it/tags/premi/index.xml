    <item>
      <title>Riconoscimenti e Premi nell&#39;Innovazione delle Pompe Chimiche</title>
      <link>https://mis3085.github.io/docs-assoma/it/news/awards/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      
      <guid>https://mis3085.github.io/docs-assoma/it/news/awards/</guid>
      <description>&lt;h2 class=&#34;relative group&#34;&gt;Celebrazione del Riconoscimento del Settore e dell&amp;rsquo;Eccellenza del Prodotto 
    &lt;div id=&#34;celebrazione-del-riconoscimento-del-settore-e-delleccellenza-del-prodotto&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
