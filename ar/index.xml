        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%d8%b1%d8%a4%d9%89-%d8%a3%d8%b3%d8%a7%d8%b3%d9%8a%d8%a9-%d9%84%d8%b5%d9%8a%d8%a7%d9%86%d8%a9-%d8%a3%d9%86%d8%b8%d9%85%d8%a9-%d8%a7%d9%84%d9%85%d8%b6%d8%ae%d8%a7%d8%aa&#34; aria-label=&#34;رابط&#34;&gt;#&lt;/a&gt;
