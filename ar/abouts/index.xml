&lt;figure class=&#34;grid-w50 pb-4 text-center&#34;&gt;&lt;img src=&#34;https://mis3085.github.io/docs-assoma/green-assoma_banner_10856976880055840921.jpg&#34; alt=&#34;بانر جرين أسوما&#34; class=&#34;mx-auto max-w-full h-auto&#34;/&gt;&lt;figcaption&gt;بانر جرين أسوما&lt;/figcaption&gt;&lt;/figure&gt;
